# ==============================================
# TRUST CENTER ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to frontend/.env.local and fill in your values
# DO NOT commit .env.local to version control

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
# Required for database and auth
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ==============================================
# EMAIL CONFIGURATION
# ==============================================

# Email Provider: 'mailpit' (development) or 'resend' (production) or 'sendgrid' or 'smtp'
EMAIL_PROVIDER=resend

# For Resend (Production - Recommended):
# 1. Sign up at https://resend.com (free tier: 3,000 emails/month)
# 2. Verify your email address
# 3. Get API key from dashboard: https://resend.com/api-keys
RESEND_API_KEY=

# For SendGrid (Alternative):
SENDGRID_API_KEY=

# SMTP Settings (for custom SMTP or Mailpit development):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trustcenter.com

# ==============================================
# FILE STORAGE
# ==============================================
# Note: Using Supabase Storage (no additional config needed)
# Files will be stored in Supabase Storage bucket

# ==============================================
# OPTIONAL CONFIGURATION
# ==============================================
# OpenAI API Key (if using AI features)
OPENAI_API_KEY=

# Environment
NODE_ENV=production

# ==============================================
# SECURITY BEST PRACTICES
# ==============================================
# - Never commit .env.local file to git
# - Use strong, unique API keys
# - Rotate API keys regularly
# - Use different keys for development and production
# - Monitor email sending logs for suspicious activity
# - Keep SUPABASE_SERVICE_KEY secret (server-side only)
